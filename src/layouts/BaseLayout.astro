---
import "../styles/global.css"
import Header from "../components/Header.astro"
import Sidebar from "../components/Sidebar.astro"
import Footer from "../components/Footer.astro"

export interface Props {
  title?: string
}

const { title } = Astro.props
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Documentación oficial de AprendeYa - Plataforma educativa" />
    <title>{title ? `${title} | AprendeYa` : "AprendeYa | Documentación"}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-surface text-gray-900 antialiased">
    <Header />
    <div class="flex">
      <Sidebar />
      <main class="flex-1 min-h-[calc(100vh-4rem)] md:ml-64">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
          <slot />
        </div>
      </main>
    </div>
    <Footer />
  </body>
</html>
