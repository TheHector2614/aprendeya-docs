---
import "../styles/global.css"
import Header from "../components/Header.astro"
import Sidebar from "../components/Sidebar.astro"
import Footer from "../components/Footer.astro"
import AIChatWidget from "../components/AIChatWidget.astro"
import SearchModal from "../components/SearchModal.astro"

export interface Props {
  title?: string
  description?: string
}

const { title, description = "Centro de documentación oficial de AprendeYa - Reglamento, becas, reembolsos y guías de uso." } = Astro.props
---

<!DOCTYPE html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title ? `${title} | AprendeYa Docs` : "AprendeYa | Centro de Documentación"}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--
      Las fuentes se piden desde aquí y no con @import dentro de global.css:
      un @import obliga al navegador a descargar y analizar el CSS antes de
      descubrir la petición de fuentes, encadenando dos viajes de red en la
      ruta crítica del render.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
    />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased min-h-full flex flex-col selection:bg-blue-500 selection:text-white">
    
    <!-- Top Scroll Reading Progress Bar -->
    <div id="scroll-progress" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-blue-600 via-indigo-600 to-emerald-500 z-30 transition-all duration-150" style="width: 0%"></div>

    <a href="#contenido-principal" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-xl focus:text-sm focus:font-semibold">
      Saltar al contenido
    </a>

    <!-- Main Site Navigation Header -->
    <Header />

    <!-- Site Layout Wrapper -->
    <div class="flex-1 flex max-w-7xl w-full mx-auto relative">
      <!-- Fixed Sidebar -->
      <Sidebar />

      <!-- Content + Footer Right Column -->
      <div class="flex-1 min-w-0 md:ml-64 flex flex-col justify-between min-h-[calc(100vh-4rem)]">
        <main id="contenido-principal" class="flex-1 px-4 sm:px-6 lg:px-10 py-8 lg:py-10">
          <slot />
        </main>
        
        <!-- Footer aligned inside the main column -->
        <Footer />
      </div>
    </div>

    <!-- Overlays: fuera del <header> sticky para que nada los tape -->
    <SearchModal />
    <AIChatWidget />

    <script>
      // Scroll Progress Indicator.
      // El listener es passive y el trabajo se agrupa en un rAF: leer
      // scrollHeight/clientHeight fuerza un reflow, y hacerlo en cada evento de
      // scroll degradaba el INP en documentos largos.
      const progress = document.getElementById("scroll-progress")

      if (progress) {
        let queued = false

        const update = () => {
          queued = false
          const scrolled = document.documentElement.scrollTop || document.body.scrollTop
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight
          // height es 0 cuando la página no desborda; sin esta guarda el
          // resultado era NaN y el ancho quedaba sin aplicar.
          progress.style.width = height > 0 ? `${(scrolled / height) * 100}%` : "0%"
        }

        window.addEventListener(
          "scroll",
          () => {
            if (queued) return
            queued = true
            requestAnimationFrame(update)
          },
          { passive: true }
        )
      }
    </script>
  </body>
</html>
