---
import BaseLayout from "../layouts/BaseLayout.astro"
import TableOfContents from "../components/TableOfContents.astro"
import FeedbackWidget from "../components/FeedbackWidget.astro"
import DocPagination from "../components/DocPagination.astro"
import DocRenderer from "../components/DocRenderer.astro"
import { docs } from "../content/docs"

const doc = docs.find((d) => d.id === "guia-uso")!
---

<BaseLayout title={doc.title} description={doc.description}>
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6 flex-wrap">
    <a href="/" class="hover:text-blue-600 transition-colors">Inicio</a>
    <span>›</span>
    <span class="text-slate-500">{doc.category}</span>
    <span>›</span>
    <span class="text-slate-900 truncate max-w-[200px] sm:max-w-none">{doc.title}</span>
  </nav>

  <!-- Document Header Banner -->
  <header class="mb-8 sm:mb-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-white via-slate-50 to-blue-50/50 border border-slate-200/80 shadow-xs relative overflow-hidden">
    <div class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-blue-500/10 rounded-full blur-2xl pointer-events-none"></div>
    
    <div class="flex items-center gap-3 mb-4 flex-wrap">
      <div class="w-12 h-12 rounded-2xl bg-white border border-slate-200 shadow-2xs flex items-center justify-center text-2xl">
        {doc.icon}
      </div>
      <span class="px-3 py-1 text-xs font-bold rounded-full bg-blue-50 text-blue-600 border border-blue-100">
        {doc.badge}
      </span>
      <span class="px-3 py-1 text-xs font-medium rounded-full bg-slate-100 text-slate-600">
        ⏱️ {doc.readTime}
      </span>
    </div>

    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-3">
      {doc.title}
    </h1>
    <p class="text-xs sm:text-sm text-slate-600 max-w-3xl leading-relaxed">
      {doc.description}
    </p>
  </header>

  <!-- Mobile Table of Contents Accordion -->
  <TableOfContents sections={doc.sections} />

  <!-- Main Body + TOC Sidebar Grid -->
  <div class="flex flex-col lg:flex-row gap-10 items-start">
    <!-- Document Content -->
    <article class="doc-section flex-1 min-w-0 w-full bg-white p-5 sm:p-8 lg:p-10 rounded-3xl border border-slate-200/80 shadow-xs">
      {doc.sections.map((section) => {
        const id = section.title.toLowerCase().replace(/\s+/g, '-')
        return (
          <section id={id} class="scroll-mt-24 mb-10 last:mb-0 pb-8 border-b border-slate-100 last:border-b-0 last:pb-0">
            <h2>
              <span>{section.title}</span>
            </h2>
            <DocRenderer content={section.content} />
          </section>
        )
      })}

      <!-- Interactive Feedback Widget -->
      <FeedbackWidget />

      <!-- Pagination Next / Prev -->
      <DocPagination currentId={doc.id} />
    </article>
  </div>
</BaseLayout>
