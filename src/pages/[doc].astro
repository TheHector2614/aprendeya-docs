---
import BaseLayout from "../layouts/BaseLayout.astro"
import TableOfContents from "../components/TableOfContents.astro"
import FeedbackWidget from "../components/FeedbackWidget.astro"
import DocPagination from "../components/DocPagination.astro"
import DocRenderer from "../components/DocRenderer.astro"
import { docs } from "../content/docs"
import { getAccent } from "../lib/accent"
import { slugify } from "../lib/slug"

export function getStaticPaths() {
  return docs.map((doc) => ({ params: { doc: doc.id }, props: { doc } }))
}

const { doc } = Astro.props
const accent = getAccent(doc.accent)
---

<BaseLayout title={doc.title} description={doc.description}>
  <!-- Breadcrumbs -->
  <nav aria-label="Ruta de navegación" class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6 flex-wrap">
    <a href="/" class="hover:text-blue-600 transition-colors">Inicio</a>
    <span aria-hidden="true">›</span>
    <span class="text-slate-500">{doc.category}</span>
    <span aria-hidden="true">›</span>
    <span aria-current="page" class="text-slate-900 truncate max-w-[200px] sm:max-w-none">{doc.title}</span>
  </nav>

  <!-- Document Header Banner -->
  <header class:list={["mb-8 sm:mb-10 p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-xs relative overflow-hidden", accent.headerGradient]}>
    <div class:list={["absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 rounded-full blur-2xl pointer-events-none", accent.glow]}></div>

    <div class="flex items-center gap-3 mb-4 flex-wrap">
      <div class="w-12 h-12 rounded-2xl bg-white border border-slate-200 shadow-2xs flex items-center justify-center text-2xl" aria-hidden="true">
        {doc.icon}
      </div>
      <span class:list={["px-3 py-1 text-xs font-bold rounded-full border", accent.badge]}>
        {doc.badge}
      </span>
      <span class="px-3 py-1 text-xs font-medium rounded-full bg-slate-100 text-slate-600">
        ⏱️ {doc.readTime}
      </span>
    </div>

    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-3">
      {doc.title}
    </h1>
    <p class="text-xs sm:text-sm text-slate-600 max-w-3xl leading-relaxed">
      {doc.description}
    </p>
  </header>

  <!-- Main Body + TOC Sidebar Grid -->
  <div class="flex flex-col lg:flex-row gap-10 items-start">
    <!-- Índice: acordeón en móvil, columna fija a la derecha en escritorio -->
    <TableOfContents sections={doc.sections} />

    <!-- Document Content -->
    <article class="doc-section flex-1 min-w-0 w-full bg-white p-5 sm:p-8 lg:p-10 rounded-3xl border border-slate-200/80 shadow-xs">
      {doc.sections.map((section) => (
        <section id={slugify(section.title)} class="scroll-mt-24 mb-10 last:mb-0 pb-8 border-b border-slate-100 last:border-b-0 last:pb-0">
          <h2>
            <span>{section.title}</span>
          </h2>
          <DocRenderer content={section.content} />
        </section>
      ))}

      <!-- Interactive Feedback Widget -->
      <FeedbackWidget />

      <!-- Pagination Next / Prev -->
      <DocPagination currentId={doc.id} />
    </article>
  </div>
</BaseLayout>
