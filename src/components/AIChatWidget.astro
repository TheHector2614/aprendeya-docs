---
import { docs } from "../content/docs"
import { slugify } from "../lib/slug"

// Si PUBLIC_AGENT_API_URL apunta al agente RAG (scripts/api.py), el widget
// consulta el índice semántico real. Sin esa variable cae en el índice
// estático del sitio, que solo hace coincidencia por palabra clave.
const agentApiUrl = import.meta.env.PUBLIC_AGENT_API_URL ?? ""

// Solo viaja al cliente lo necesario para la búsqueda de respaldo, no el
// contenido íntegro de cada documento.
const fallbackIndex = docs.flatMap((doc) =>
  doc.sections.map((sec) => ({
    docTitle: doc.title,
    sectionTitle: sec.title,
    excerpt: sec.content.slice(0, 180),
    href: `/${doc.id}#${slugify(sec.title)}`,
    haystack: `${doc.title} ${sec.title} ${sec.content}`.toLowerCase(),
  }))
)
---

<!-- Floating AI Chat Trigger Button -->
<div class="fixed bottom-6 right-6 z-50">
  <button
    id="ai-chat-trigger"
    type="button"
    class="group relative flex items-center gap-2.5 px-4 py-3 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white font-bold text-xs rounded-full shadow-xl shadow-blue-500/30 hover:shadow-blue-500/40 transition-all duration-300 transform hover:scale-105 active:scale-95"
    aria-label="Abrir Asistente IA"
    aria-controls="ai-chat-window"
    aria-expanded="false"
  >
    <!-- Glowing Ring -->
    <span class="absolute -inset-0.5 rounded-full bg-gradient-to-r from-blue-400 to-purple-400 opacity-60 blur-xs group-hover:opacity-100 transition-opacity animate-pulse"></span>
    
    <span class="relative flex items-center gap-2">
      <span class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center text-sm shadow-2xs">🤖</span>
      <span class="hidden sm:inline tracking-wide">Asistente IA</span>
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
    </span>
  </button>
</div>

<!-- Floating AI Chat Window -->
<div
  id="ai-chat-window"
  role="dialog"
  aria-label="Asistente IA AprendeYa"
  class="fixed bottom-20 right-4 sm:right-6 z-50 hidden w-[92vw] sm:w-[420px] max-h-[600px] h-[80vh] bg-white/95 backdrop-blur-xl rounded-3xl shadow-2xl border border-slate-200/80 flex-col overflow-hidden animate-fade-in"
>
  <!-- Window Header -->
  <div class="p-4 bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white flex items-center justify-between border-b border-white/10 shrink-0">
    <div class="flex items-center gap-3">
      <div class="relative w-9 h-9 rounded-2xl bg-gradient-to-tr from-blue-500 to-purple-500 flex items-center justify-center text-lg shadow-md shadow-purple-500/30">
        🤖
        <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-400 border-2 border-slate-900 rounded-full"></span>
      </div>
      <div>
        <h3 class="text-sm font-bold tracking-wide flex items-center gap-1.5">
          Asistente IA AprendeYa
          <span class="px-1.5 py-0.2 text-[9px] bg-blue-500/30 text-blue-300 rounded-full border border-blue-400/30">v2.0</span>
        </h3>
        <p class="text-[11px] text-slate-300 opacity-80">En línea • Responde dudas de toda la plataforma</p>
      </div>
    </div>
    <button
      id="ai-chat-close"
      class="p-1.5 text-slate-400 hover:text-white hover:bg-white/10 rounded-xl transition-colors"
      aria-label="Cerrar ventana de chat"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Chat Messages Container -->
  <div id="ai-chat-messages" role="log" aria-live="polite" aria-atomic="false" class="flex-1 p-4 overflow-y-auto space-y-4 text-xs bg-slate-50/50">
    
    <!-- Welcome Message -->
    <div class="flex items-start gap-2.5">
      <span class="w-7 h-7 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-xs shrink-0 font-bold">🤖</span>
      <div class="bg-white p-3.5 rounded-2xl rounded-tl-xs border border-slate-200/80 shadow-2xs text-slate-700 max-w-[85%] space-y-2">
        <p class="font-medium">¡Hola! 👋 Soy la Inteligencia Artificial de <strong>AprendeYa</strong>.</p>
        <p>Puedo resolver cualquier duda sobre reglamentos, convocatorias de becas, solicitud de reembolsos o uso de la plataforma.</p>
      </div>
    </div>

    <!-- Quick Suggestion Chips -->
    <div id="ai-suggestions" class="pt-2 space-y-1.5">
      <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-1">Preguntas sugeridas:</div>
      <div class="flex flex-wrap gap-1.5">
        <button data-prompt="¿Cómo solicito una beca?" class="ai-chip px-3 py-1.5 bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-600 border border-slate-200 hover:border-blue-300 rounded-xl text-[11px] font-medium transition-all text-left shadow-2xs">
          🎓 ¿Cómo solicito una beca?
        </button>
        <button data-prompt="¿Cuál es el plazo para solicitar reembolso?" class="ai-chip px-3 py-1.5 bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-600 border border-slate-200 hover:border-blue-300 rounded-xl text-[11px] font-medium transition-all text-left shadow-2xs">
          💳 ¿Cuál es el plazo de reembolso?
        </button>
        <button data-prompt="¿Cómo obtengo mi certificado?" class="ai-chip px-3 py-1.5 bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-600 border border-slate-200 hover:border-blue-300 rounded-xl text-[11px] font-medium transition-all text-left shadow-2xs">
          📜 ¿Cómo obtengo mi certificado?
        </button>
      </div>
    </div>

  </div>

  <!-- Typing Indicator (Hidden by default) -->
  <div id="ai-typing" class="hidden px-4 py-2 bg-slate-50 border-t border-slate-100 flex items-center gap-2 text-xs text-slate-400">
    <span class="w-2 h-2 bg-blue-500 rounded-full animate-bounce"></span>
    <span class="w-2 h-2 bg-blue-500 rounded-full animate-bounce [animation-delay:0.2s]"></span>
    <span class="w-2 h-2 bg-blue-500 rounded-full animate-bounce [animation-delay:0.4s]"></span>
    <span class="text-[11px] italic">IA AprendeYa consultando la documentación...</span>
  </div>

  <!-- Message Input Form -->
  <form id="ai-chat-form" class="p-3 bg-white border-t border-slate-200/80 flex items-center gap-2 shrink-0">
    <input
      id="ai-chat-input"
      type="text"
      placeholder="Haz una pregunta sobre los documentos..."
      class="flex-1 px-3.5 py-2.5 bg-slate-100/80 border border-slate-200/80 rounded-2xl text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:bg-white transition-all"
      autocomplete="off"
    />
    <button
      type="submit"
      class="p-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl font-bold shadow-md shadow-blue-500/20 transition-all active:scale-95 shrink-0"
      aria-label="Enviar mensaje"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
  </form>

</div>

<script is:inline define:vars={{ agentApiUrl, fallbackIndex }}>
  const triggerBtn = document.getElementById("ai-chat-trigger");
  const chatWindow = document.getElementById("ai-chat-window");
  const closeBtn = document.getElementById("ai-chat-close");
  const form = document.getElementById("ai-chat-form");
  const input = document.getElementById("ai-chat-input");
  const messagesContainer = document.getElementById("ai-chat-messages");
  const typingIndicator = document.getElementById("ai-typing");

  let lastFocused = null;
  let pending = false;

  function isOpen() {
    return !chatWindow?.classList.contains("hidden");
  }

  function setOpen(open) {
    chatWindow?.classList.toggle("hidden", !open);
    chatWindow?.classList.toggle("flex", open);
    triggerBtn?.setAttribute("aria-expanded", String(open));
    triggerBtn?.setAttribute("aria-label", open ? "Cerrar Asistente IA" : "Abrir Asistente IA");
    if (open) {
      lastFocused = document.activeElement;
      setTimeout(() => input?.focus(), 100);
    } else if (lastFocused instanceof HTMLElement) {
      lastFocused.focus();
      lastFocused = null;
    }
  }

  triggerBtn?.addEventListener("click", () => setOpen(!isOpen()));
  closeBtn?.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) setOpen(false);
  });

  document.querySelectorAll(".ai-chip").forEach((chip) => {
    chip.addEventListener("click", () => {
      const prompt = chip.getAttribute("data-prompt");
      if (prompt) handleUserQuery(prompt);
    });
  });

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const query = input?.value.trim();
    if (query) {
      handleUserQuery(query);
      if (input) input.value = "";
    }
  });

  const ESCAPES = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, (m) => ESCAPES[m]);
  }

  function appendUserMessage(text) {
    const userBubble = document.createElement("div");
    userBubble.className = "flex items-start justify-end gap-2";
    userBubble.innerHTML = `
      <div class="bg-blue-600 text-white p-3 rounded-2xl rounded-tr-xs shadow-2xs max-w-[85%] text-xs">
        ${escapeHtml(text)}
      </div>
    `;
    messagesContainer?.appendChild(userBubble);
    scrollToBottom();
  }

  function appendAIMessage(htmlContent) {
    const aiBubble = document.createElement("div");
    aiBubble.className = "flex items-start gap-2.5 animate-fade-in";
    aiBubble.innerHTML = `
      <span class="w-7 h-7 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-xs shrink-0 font-bold" aria-hidden="true">🤖</span>
      <div class="bg-white p-3.5 rounded-2xl rounded-tl-xs border border-slate-200/80 shadow-2xs text-slate-700 max-w-[85%] space-y-2 leading-relaxed">
        ${htmlContent}
      </div>
    `;
    messagesContainer?.appendChild(aiBubble);
    scrollToBottom();
  }

  function scrollToBottom() {
    if (messagesContainer) {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
  }

  async function handleUserQuery(userText) {
    // Sin este guardia, pulsar Enter repetidamente lanzaba peticiones en
    // paralelo y las respuestas podían llegar desordenadas al hilo.
    if (pending) return;
    pending = true;

    appendUserMessage(userText);
    document.getElementById("ai-suggestions")?.style.setProperty("display", "none");
    typingIndicator?.classList.remove("hidden");

    try {
      const answer = agentApiUrl
        ? await askAgent(userText)
        : localAnswer(userText);
      appendAIMessage(answer);
    } finally {
      typingIndicator?.classList.add("hidden");
      pending = false;
    }
  }

  // ── Agente RAG real (scripts/api.py) ──────────────────────────────
  async function askAgent(question) {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 20000);
    try {
      const res = await fetch(`${agentApiUrl.replace(/\/+$/, "")}/ask`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ question, top_k: 3 }),
        signal: controller.signal,
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      return renderAgentAnswer(data);
    } catch (err) {
      // Si el agente no responde se degrada al índice estático en lugar de
      // dejar la burbuja vacía.
      return `
        <p class="text-[11px] text-amber-600 font-semibold">El asistente no está disponible ahora mismo; esta respuesta viene del índice del sitio.</p>
        ${localAnswer(question)}
      `;
    } finally {
      clearTimeout(timeout);
    }
  }

  function renderAgentAnswer(data) {
    const cuerpo = escapeHtml(data.respuesta ?? "")
      .split(/\n{2,}/)
      .map((p) => `<p>${p.replace(/\n/g, "<br>")}</p>`)
      .join("");

    const fuentes = (data.fuentes ?? [])
      .map((f) => {
        const label = f.seccion ? `${f.titulo} / ${f.seccion}` : f.titulo;
        return `<li>${escapeHtml(label)}</li>`;
      })
      .join("");

    return `
      ${cuerpo}
      ${
        fuentes
          ? `<div class="mt-2 pt-2 border-t border-slate-100">
               <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Fuentes</div>
               <ul class="list-disc pl-4 text-[11px] text-slate-500 space-y-0.5">${fuentes}</ul>
             </div>`
          : ""
      }
    `;
  }

  // ── Respaldo sin backend: búsqueda por palabras sobre el índice del sitio ──
  function localAnswer(query) {
    // Se puntúa por número de términos coincidentes en lugar de comprobar si
    // la frase completa aparece literalmente: "¿cómo pido una beca?" nunca
    // aparece tal cual dentro de un documento.
    const terms = query
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .split(/[^a-z0-9]+/)
      .filter((t) => t.length > 3);

    let best = null;
    let bestScore = 0;

    for (const entry of fallbackIndex) {
      const haystack = entry.haystack.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      const score = terms.reduce((acc, t) => acc + (haystack.includes(t) ? 1 : 0), 0);
      if (score > bestScore) {
        best = entry;
        bestScore = score;
      }
    }

    if (best && bestScore > 0) {
      return `
        <p class="font-bold text-slate-900">ℹ️ ${escapeHtml(best.sectionTitle)}</p>
        <p class="text-slate-600">${escapeHtml(best.excerpt)}…</p>
        <div class="mt-2 pt-2 border-t border-slate-100">
          <a href="${escapeHtml(best.href)}" class="inline-flex items-center gap-1 font-bold text-blue-600 hover:underline">
            📄 Ir a ${escapeHtml(best.docTitle)} →
          </a>
        </div>
      `;
    }

    return `
      <p>No encontré nada sobre <em>"${escapeHtml(query)}"</em> en la documentación publicada.</p>
      <div class="mt-2 pt-2 border-t border-slate-100 flex flex-col gap-1">
        <a href="/faq" class="font-bold text-blue-600 hover:underline">❓ Ver Preguntas Frecuentes</a>
        <a href="mailto:soporte@aprendeya.edu" class="font-bold text-emerald-600 hover:underline">✉️ Escribir a soporte@aprendeya.edu</a>
      </div>
    `;
  }
</script>
