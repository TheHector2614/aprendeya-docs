---
import { docs } from "../content/docs"
import { slugify } from "../lib/slug"

// El índice se precalcula en build: el script del cliente solo recibe título,
// texto en minúsculas y href, en lugar del contenido completo de cada documento.
const searchIndex = docs.flatMap((doc) => [
  {
    title: doc.title,
    subtitle: doc.description,
    icon: doc.icon,
    href: `/${doc.id}`,
    haystack: `${doc.title} ${doc.description}`.toLowerCase(),
  },
  ...doc.sections.map((sec) => ({
    title: `${doc.title} › ${sec.title}`,
    subtitle: sec.content.slice(0, 110) + "…",
    icon: doc.icon,
    href: `/${doc.id}#${slugify(sec.title)}`,
    haystack: `${sec.title} ${sec.content}`.toLowerCase(),
  })),
])
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden items-start justify-center pt-16 sm:pt-24 px-4 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-label="Buscar en la documentación"
>
  <!-- Backdrop -->
  <div id="search-backdrop" class="fixed inset-0"></div>

  <!-- Modal Card -->
  <div class="relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-200/80 overflow-hidden z-10 flex flex-col max-h-[80vh] animate-fade-in">
    <!-- Search Input Header -->
    <div class="flex items-center px-4 py-3.5 border-b border-slate-100 bg-slate-50/50">
      <svg class="w-5 h-5 text-blue-600 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-input"
        type="text"
        class="w-full bg-transparent text-slate-900 placeholder-slate-400 text-base focus:outline-none"
        placeholder="Buscar documentos, guías, preguntas..."
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <button
        id="search-close"
        type="button"
        class="ml-2 text-xs font-semibold px-2 py-1 bg-slate-200 text-slate-600 rounded-md hover:bg-slate-300 transition-colors"
        aria-label="Cerrar búsqueda"
      >
        ESC
      </button>
    </div>

    <!-- Search Results Container -->
    <div id="search-results" role="listbox" aria-label="Resultados" class="overflow-y-auto p-3 flex-1"></div>

    <!-- Modal Footer -->
    <div class="px-4 py-2.5 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
      <div class="flex items-center gap-2">
        <span class="px-1.5 py-0.5 bg-white rounded border border-slate-200 font-mono text-[10px]">↑↓</span>
        <span>Navegar</span>
        <span class="px-1.5 py-0.5 bg-white rounded border border-slate-200 font-mono text-[10px]">ESC</span>
        <span>Cerrar</span>
      </div>
      <span>AprendeYa Docs</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchIndex }}>
  const modal = document.getElementById("search-modal");
  const backdrop = document.getElementById("search-backdrop");
  const input = document.getElementById("search-input");
  const closeBtn = document.getElementById("search-close");
  const resultsContainer = document.getElementById("search-results");

  const EMPTY_STATE = `
    <div class="text-center py-10 px-4 text-slate-400">
      <p class="text-sm font-medium">Escribe algo para buscar en la documentación...</p>
      <div class="mt-4 flex justify-center gap-2 flex-wrap">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-600 border border-blue-100">Reglamento</span>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-600 border border-emerald-100">Becas</span>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-indigo-50 text-indigo-600 border border-indigo-100">Reembolsos</span>
      </div>
    </div>
  `;

  const NO_RESULTS = `
    <div class="text-center py-12 px-4 text-slate-500">
      <p class="text-base font-semibold">No se encontraron resultados</p>
      <p class="text-xs mt-1 text-slate-400">Intenta con otros términos como "certificado" o "beca"</p>
    </div>
  `;

  // Los títulos y descripciones vienen del contenido del sitio, pero se
  // escapan igualmente: el índice se inyecta con innerHTML y cualquier
  // documento futuro con < o & rompería el marcado.
  const ESCAPES = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, (m) => ESCAPES[m]);
  }

  let activeIndex = -1;
  let lastFocused = null;

  function resetResults() {
    activeIndex = -1;
    input?.setAttribute("aria-expanded", "false");
    if (resultsContainer) resultsContainer.innerHTML = EMPTY_STATE;
  }

  function openModal() {
    // Se guarda el elemento enfocado para devolverle el foco al cerrar; sin
    // esto el usuario de teclado volvía al principio del documento.
    lastFocused = document.activeElement;
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    document.body.style.overflow = "hidden";
    setTimeout(() => input?.focus(), 50);
  }

  function closeModal() {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
    document.body.style.overflow = "";
    if (input) input.value = "";
    resetResults();
    if (lastFocused instanceof HTMLElement) lastFocused.focus();
    lastFocused = null;
  }

  function isOpen() {
    return !modal?.classList.contains("hidden");
  }

  function options() {
    return resultsContainer ? [...resultsContainer.querySelectorAll("[data-result]")] : [];
  }

  function highlight(next) {
    const items = options();
    if (!items.length) return;
    activeIndex = (next + items.length) % items.length;
    items.forEach((el, i) => {
      const on = i === activeIndex;
      el.classList.toggle("bg-blue-50/80", on);
      el.setAttribute("aria-selected", String(on));
      if (on) el.scrollIntoView({ block: "nearest" });
    });
  }

  function render(query) {
    if (!resultsContainer) return;
    activeIndex = -1;

    if (!query) {
      resetResults();
      return;
    }

    const matches = searchIndex.filter((item) => item.haystack.includes(query)).slice(0, 20);
    input?.setAttribute("aria-expanded", String(matches.length > 0));

    if (!matches.length) {
      resultsContainer.innerHTML = NO_RESULTS;
      return;
    }

    resultsContainer.innerHTML = `
      <div class="space-y-1">
        ${matches
          .map(
            (item) => `
          <a
            data-result
            role="option"
            aria-selected="false"
            href="${escapeHtml(item.href)}"
            class="flex items-start gap-3 p-3 rounded-xl hover:bg-blue-50/80 transition-colors group"
          >
            <span class="text-xl p-2 rounded-lg bg-slate-100 group-hover:bg-blue-100 transition-colors shrink-0" aria-hidden="true">
              ${escapeHtml(item.icon)}
            </span>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-semibold text-slate-900 group-hover:text-blue-600 transition-colors truncate">
                ${escapeHtml(item.title)}
              </div>
              <div class="text-xs text-slate-500 line-clamp-1 mt-0.5">
                ${escapeHtml(item.subtitle)}
              </div>
            </div>
          </a>
        `
          )
          .join("")}
      </div>
    `;
  }

  resetResults();

  window.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      isOpen() ? closeModal() : openModal();
      return;
    }
    if (!isOpen()) return;

    if (e.key === "Escape") {
      e.preventDefault();
      closeModal();
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      highlight(activeIndex + 1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      highlight(activeIndex - 1);
    } else if (e.key === "Enter" && activeIndex >= 0) {
      e.preventDefault();
      options()[activeIndex]?.click();
    }
  });

  window.addEventListener("open-search-modal", openModal);
  backdrop?.addEventListener("click", closeModal);
  closeBtn?.addEventListener("click", closeModal);
  resultsContainer?.addEventListener("click", (e) => {
    if (e.target instanceof Element && e.target.closest("[data-result]")) closeModal();
  });

  // Debounce: con el índice completo en memoria cada pulsación reconstruía
  // todo el listado, lo que se notaba al teclear rápido en móviles.
  let debounce;
  input?.addEventListener("input", (e) => {
    const query = e.target.value.trim().toLowerCase();
    clearTimeout(debounce);
    debounce = setTimeout(() => render(query), 120);
  });
</script>
