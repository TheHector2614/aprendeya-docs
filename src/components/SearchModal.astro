---
import { docs } from "../content/docs"
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden items-start justify-center pt-16 sm:pt-24 px-4 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-200"
>
  <!-- Backdrop -->
  <div id="search-backdrop" class="fixed inset-0"></div>

  <!-- Modal Card -->
  <div class="relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-200/80 overflow-hidden z-10 flex flex-col max-h-[80vh] animate-fade-in">
    <!-- Search Input Header -->
    <div class="flex items-center px-4 py-3.5 border-b border-slate-100 bg-slate-50/50">
      <svg class="w-5 h-5 text-blue-600 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-input"
        type="text"
        class="w-full bg-transparent text-slate-900 placeholder-slate-400 text-base focus:outline-none"
        placeholder="Buscar documentos, guías, preguntas..."
        autocomplete="off"
      />
      <button
        id="search-close"
        class="ml-2 text-xs font-semibold px-2 py-1 bg-slate-200 text-slate-600 rounded-md hover:bg-slate-300 transition-colors"
      >
        ESC
      </button>
    </div>

    <!-- Search Results Container -->
    <div id="search-results" class="overflow-y-auto p-3 flex-1">
      <div class="text-center py-10 px-4 text-slate-400">
        <p class="text-sm font-medium">Escribe algo para buscar en la documentación...</p>
        <div class="mt-4 flex justify-center gap-2 flex-wrap">
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-600 border border-blue-100">
            Reglamento
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-600 border border-emerald-100">
            Becas
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-indigo-50 text-indigo-600 border border-indigo-100">
            Reembolsos
          </span>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="px-4 py-2.5 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
      <div class="flex items-center gap-2">
        <span class="px-1.5 py-0.5 bg-white rounded border border-slate-200 font-mono text-[10px]">ESC</span>
        <span>Cerrar</span>
      </div>
      <span>AprendeYa Docs</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ docs }}>
  const modal = document.getElementById("search-modal");
  const backdrop = document.getElementById("search-backdrop");
  const input = document.getElementById("search-input");
  const closeBtn = document.getElementById("search-close");
  const resultsContainer = document.getElementById("search-results");

  function openModal() {
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    setTimeout(() => input?.focus(), 50);
  }

  function closeModal() {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
    if (input) input.value = "";
    resetResults();
  }

  function resetResults() {
    if (!resultsContainer) return;
    resultsContainer.innerHTML = `
      <div class="text-center py-10 px-4 text-slate-400">
        <p class="text-sm font-medium">Escribe algo para buscar en la documentación...</p>
        <div class="mt-4 flex justify-center gap-2 flex-wrap">
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-600 border border-blue-100">
            Reglamento
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-600 border border-emerald-100">
            Becas
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-indigo-50 text-indigo-600 border border-indigo-100">
            Reembolsos
          </span>
        </div>
      </div>
    `;
  }

  window.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (modal?.classList.contains("hidden")) {
        openModal();
      } else {
        closeModal();
      }
    } else if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
      closeModal();
    }
  });

  window.addEventListener("open-search-modal", openModal);
  backdrop?.addEventListener("click", closeModal);
  closeBtn?.addEventListener("click", closeModal);

  input?.addEventListener("input", (e) => {
    const query = e.target.value.trim().toLowerCase();
    if (!query) {
      resetResults();
      return;
    }

    const matches = [];
    docs.forEach((doc) => {
      if (doc.title.toLowerCase().includes(query) || doc.description.toLowerCase().includes(query)) {
        matches.push({
          title: doc.title,
          subtitle: doc.description,
          icon: doc.icon,
          href: `/${doc.id}`,
        });
      }
      (doc.sections || []).forEach((sec) => {
        if (sec.title.toLowerCase().includes(query) || sec.content.toLowerCase().includes(query)) {
          matches.push({
            title: `${doc.title} › ${sec.title}`,
            subtitle: sec.content.slice(0, 110) + "...",
            icon: doc.icon,
            href: `/${doc.id}#${encodeURIComponent(sec.title.toLowerCase().replace(/\s+/g, "-"))}`,
          });
        }
      });
    });

    if (matches.length === 0) {
      resultsContainer.innerHTML = `
        <div class="text-center py-12 px-4 text-slate-500">
          <p class="text-base font-semibold">No se encontraron resultados</p>
          <p class="text-xs mt-1 text-slate-400">Intenta con otros términos como "certificado" o "beca"</p>
        </div>
      `;
      return;
    }

    resultsContainer.innerHTML = `
      <div class="space-y-1">
        ${matches
          .map(
            (item) => `
          <a
            href="${item.href}"
            class="flex items-start gap-3 p-3 rounded-xl hover:bg-blue-50/80 transition-colors group"
            onclick="document.getElementById('search-modal').classList.add('hidden')"
          >
            <span class="text-xl p-2 rounded-lg bg-slate-100 group-hover:bg-blue-100 transition-colors shrink-0">
              ${item.icon}
            </span>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-semibold text-slate-900 group-hover:text-blue-600 transition-colors truncate">
                ${item.title}
              </div>
              <div class="text-xs text-slate-500 line-clamp-1 mt-0.5">
                ${item.subtitle}
              </div>
            </div>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600 shrink-0 self-center opacity-0 group-hover:opacity-100 transition-all -translate-x-1 group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        `
          )
          .join("")}
      </div>
    `;
  });
</script>
