---
import { docs } from "../content/docs"
const currentPath = Astro.url.pathname
---

<aside
  data-sidebar
  class="fixed top-16 left-0 z-30 w-64 h-[calc(100vh-4rem)] bg-white border-r border-gray-200 overflow-y-auto -translate-x-full md:translate-x-0 transition-transform duration-200"
>
  <nav class="p-4">
    <a
      href="/"
      class={`sidebar-link ${currentPath === "/" ? "active" : ""}`}
    >
      <span class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></polyline></svg>
        Inicio
      </span>
    </a>
    <div class="mt-4 mb-2 px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">
      Documentos
    </div>
    {docs.map((doc) => (
      <a
        href={`/${doc.id}`}
        class={`sidebar-link ${currentPath === `/${doc.id}` ? "active" : ""}`}
      >
        <span class="flex items-center gap-2">
          <span>{doc.icon}</span>
          {doc.title}
        </span>
      </a>
    ))}
  </nav>
</aside>

<script>
  document.addEventListener("click", (e) => {
    const sidebar = document.querySelector("[data-sidebar]")
    const toggle = document.getElementById("menu-toggle")
    if (
      sidebar?.classList.contains("translate-x-0") &&
      !sidebar.contains(e.target as Node) &&
      !toggle?.contains(e.target as Node)
    ) {
      sidebar.classList.remove("translate-x-0")
      sidebar.classList.add("-translate-x-full")
    }
  })
</script>
