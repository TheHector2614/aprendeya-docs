---
import { docs } from "../content/docs"
const currentPath = Astro.url.pathname
---

<!-- Mobile Backdrop Overlay -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-20 hidden md:hidden transition-opacity duration-200"
></div>

<!-- Sidebar Container -->
<aside
  data-sidebar
  class="fixed top-16 left-0 z-30 w-64 h-[calc(100vh-4rem)] bg-white/95 backdrop-blur-md border-r border-slate-200/80 overflow-y-auto -translate-x-full md:translate-x-0 transition-transform duration-200 shadow-2xl md:shadow-none"
>
  <nav class="p-4 space-y-6">
    <!-- Home Navigation -->
    <div>
      <a
        href="/"
        class={`sidebar-link ${currentPath === "/" ? "active" : ""}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span>Inicio de la Doc</span>
      </a>
    </div>

    <!-- Documents Group -->
    <div>
      <div class="px-3 mb-2 flex items-center justify-between text-[11px] font-bold text-slate-400 uppercase tracking-wider">
        <span>Guías y Políticas</span>
        <span class="px-1.5 py-0.5 rounded-full bg-slate-100 text-slate-600 text-[10px]">{docs.length}</span>
      </div>
      <div class="space-y-1">
        {docs.map((doc) => {
          const isActive = currentPath === `/${doc.id}`
          return (
            <a
              href={`/${doc.id}`}
              class={`sidebar-link ${isActive ? "active" : ""}`}
            >
              <span class="text-base shrink-0">{doc.icon}</span>
              <span class="truncate flex-1">{doc.title}</span>
              {isActive && (
                <span class="w-1.5 h-1.5 rounded-full bg-white shrink-0"></span>
              )}
            </a>
          )
        })}
      </div>
    </div>

    <!-- Quick Resources Card -->
    <div class="pt-4 border-t border-slate-200/60">
      <div class="p-3.5 bg-slate-50 border border-slate-200/70 rounded-2xl">
        <div class="flex items-center gap-2 text-xs font-bold text-slate-800 mb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Garantía AprendeYa
        </div>
        <p class="text-[11px] text-slate-500 leading-relaxed">
          Todos los certificados son verificables mediante código QR único.
        </p>
      </div>
    </div>
  </nav>
</aside>

<script>
  const sidebar = document.querySelector("[data-sidebar]")
  const toggle = document.getElementById("menu-toggle")
  const backdrop = document.getElementById("sidebar-backdrop")

  function openSidebar() {
    sidebar?.classList.remove("-translate-x-full")
    sidebar?.classList.add("translate-x-0")
    backdrop?.classList.remove("hidden")
  }

  function closeSidebar() {
    sidebar?.classList.add("-translate-x-full")
    sidebar?.classList.remove("translate-x-0")
    backdrop?.classList.add("hidden")
  }

  toggle?.addEventListener("click", (e) => {
    e.stopPropagation()
    if (sidebar?.classList.contains("translate-x-0")) {
      closeSidebar()
    } else {
      openSidebar()
    }
  })

  backdrop?.addEventListener("click", closeSidebar)

  // Close sidebar when clicking links on mobile
  sidebar?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      if (window.innerWidth < 768) {
        closeSidebar()
      }
    })
  })
</script>
