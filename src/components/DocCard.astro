---
export interface Props {
  icon: string
  title: string
  description: string
  href: string
  category?: string
  badge?: string
  readTime?: string
}

const { icon, title, description, href, category = "Documentación", badge, readTime = "5 min de lectura" } = Astro.props
---

<a
  href={href}
  class="group relative flex flex-col justify-between p-6 bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-xl hover:shadow-blue-500/5 hover:border-blue-500/40 transition-all duration-300 transform hover:-translate-y-1 overflow-hidden"
>
  <!-- Background subtle glow -->
  <div class="absolute top-0 right-0 -mt-8 -mr-8 w-24 h-24 bg-gradient-to-br from-blue-500/10 to-emerald-500/10 rounded-full blur-xl group-hover:scale-150 transition-transform duration-500"></div>

  <div>
    <!-- Card Top Header -->
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-slate-50 to-blue-50/80 border border-slate-200/60 flex items-center justify-center text-2xl group-hover:scale-110 group-hover:border-blue-300 transition-all shadow-2xs">
        {icon}
      </div>
      {badge && (
        <span class="px-2.5 py-1 text-[11px] font-bold rounded-full bg-blue-50 text-blue-600 border border-blue-100/80 tracking-wide">
          {badge}
        </span>
      )}
    </div>

    <!-- Category & Title -->
    <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
      {category}
    </div>
    <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-snug">
      {title}
    </h3>

    <!-- Description -->
    <p class="mt-2 text-xs text-slate-500 leading-relaxed line-clamp-3">
      {description}
    </p>
  </div>

  <!-- Card Footer -->
  <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-400 group-hover:text-slate-600 transition-colors">
    <span class="flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      {readTime}
    </span>
    <span class="inline-flex items-center gap-1 text-blue-600 font-bold group-hover:translate-x-1 transition-transform">
      Explorar
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </span>
  </div>
</a>
